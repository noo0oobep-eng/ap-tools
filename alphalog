<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>AP AlphaLog AI – Upload Trade Log</title>
  <style>
    :root{--bg:#0b0f14;--card:#121822;--text:#e8eef6;--muted:#9fb0c3;--accent:#58a6ff;}
    *{box-sizing:border-box}
    body{
      margin:0;
      min-height:100vh;
      background:var(--bg);
      color:var(--text);
      font:16px/1.6 system-ui,-apple-system,Segoe UI,Roboto,Arial;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:20px;
    }
    .wrap{
      max-width:640px;
      width:100%;
      background:rgba(16,20,26,.9);
      border-radius:14px;
      border:1px solid rgba(255,255,255,.12);
      padding:22px 22px 18px;
      box-shadow:0 14px 34px rgba(0,0,0,.55);
    }
    h1{margin:0 0 6px;font-size:26px;}
    .lead{margin:0 0 14px;color:var(--muted);}
    label{display:block;margin:12px 0 6px;font-weight:600;font-size:0.9rem;}
    input[type="file"]{
      width:100%;
      padding:10px;
      border-radius:8px;
      border:1px solid rgba(255,255,255,.18);
      background:#05070b;
      color:var(--text);
    }
    .hint{font-size:0.8rem;color:var(--muted);margin-top:4px;}
    button{
      margin-top:16px;
      padding:10px 16px;
      border-radius:8px;
      border:none;
      cursor:pointer;
      background:#00d3a7;
      color:#00110c;
      font-weight:600;
      font-size:0.95rem;
    }
    .note{
      margin-top:18px;
      font-size:0.85rem;
      color:var(--muted);
    }
    a{color:var(--accent);text-decoration:none;}
    a:hover{text-decoration:underline;}
  </style>
</head>
<body>
  <div class="wrap">
    <h1>AP AlphaLog AI</h1>
    <p class="lead">Upload your <code>.alog</code> file for analysis.</p>

    <form onsubmit="event.preventDefault(); alert('Basic analyser backend coming soon – keep your .alog files, they will work with the live version.');">
      <label for="alog-file">AlphaLog file</label>
      <input id="alog-file" type="file" accept=".alog" />
      <div class="hint">
        Exported by the MT5 EA: <code>AP AlphaLog AI – MT5 Trade Journal Engine</code>
      </div>

      <button type="submit">Analyse (preview)</button>
    </form>

    <p class="note">
      Basic on-screen stats will be free. The <strong>full PDF diagnostic report</strong> is available via the
      <a href="/#alphalog-ai">Get Full Report</a> option on the main site.
    </p>

    <p class="note">
      <a href="/">← Back to AP Trading Tools</a>
    </p>
  </div>
</body>
</html>
